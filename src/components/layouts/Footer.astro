---
import stateConfig from '~@/slate.config';
import type { ThemeOptions } from '@/typings/config';
import ThemeSelect from '@/components/theme-select';
import SocialLinks from '@/components/social-links';
import slateConfig from '~@/slate.config';

interface Props {
  copyright?: string;
  email?: string;
}

const {
  copyright = stateConfig.footer?.copyright,
  email = stateConfig.footer?.email,
} = Astro.props;
---

<footer class="mt-auto">
  {!!slateConfig.socialLinks && <SocialLinks client:visible />}
  <div class="mt-4 flex items-center justify-between">
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-slate8">
      <span>{copyright}</span>
      {email && (
        <a
          href={`mailto:${email}`}
          class="inline-flex items-center gap-1.5 underline underline-offset-4"
        >
          <span class="footer-mail-icon" aria-hidden="true"></span>
          <span>{email}</span>
        </a>
      )}
    </div>
    {/* S theme selection */}
    {(stateConfig.theme as ThemeOptions).enableUserChange && <ThemeSelect client:visible />}
    {/* E theme selection */}
  </div>
</footer>

<style>
  .footer-mail-icon {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    background-color: currentColor;
    mask: url('../../assets/images/mail.svg') no-repeat center / contain;
  }
</style>
