---
import dayjs from 'dayjs';
import { render } from 'astro:content';
import { getTranslations } from '@/i18n';
import PageLayout from '@/components/layouts/PageLayout.astro';
import ArticleJsonLd from '@/components/json-ld/article.astro';
import Button from '@/components/button';
import AffixTitle from '@/components/affix-title';
import Share from '@/components/share';
import Toc from '@/components/toc';
import CodeGroupEvent from '@/components/code-group-event';
import slateConfig from '~@/slate.config';
import { getFullTitle } from '@/helpers/utils';
import {
  getLocalizedPosts,
  getPostPaths,
  type ResolvedPost,
} from '@/helpers/posts';
import 'remark-block-containers/css';
import '@/assets/style/blog.css';

export async function getStaticPaths() {
  return getPostPaths();
}

type Props = ResolvedPost;

const { entry, locale, isAuto, slug } = Astro.props as Props;
const t = getTranslations(locale);
const { Content, remarkPluginFrontmatter, headings } = await render(entry);
const posts = await getLocalizedPosts(locale);
const currentIndex = posts.findIndex((post) => post.slug === slug);
// The list is newest-first; previous/next follow chronological publication order.
const previousPost = currentIndex >= 0 ? posts[currentIndex + 1] : undefined;
const nextPost = currentIndex > 0 ? posts[currentIndex - 1] : undefined;

const lastModifiedDate = dayjs(
  remarkPluginFrontmatter.lastModified
    ? remarkPluginFrontmatter.lastModified
    : undefined,
);
const lastModified = lastModifiedDate.isSame(dayjs(), 'year')
  ? lastModifiedDate.format('MMM DD')
  : lastModifiedDate.format('MMM DD, YYYY');
const pubDate = dayjs(entry.data.pubDate);
const formattedPubDate = pubDate.isSame(dayjs(), 'year')
  ? pubDate.format('MMM DD')
  : pubDate.format('MMM DD, YYYY');
const homeHref = `/${locale}/`;

const shareLabels = {
  label: t('blog.share.label'),
  bookmark: t('blog.share.bookmark'),
  bookmarkHint: t('blog.share.bookmarkHint'),
  bookmarkMobileHint: t('blog.share.bookmarkMobileHint'),
  copyLink: t('blog.share.copyLink'),
  copied: t('blog.share.copied'),
  copying: t('blog.share.copying'),
  copyFailed: t('blog.share.copyFailed'),
  x: t('blog.share.shareTo', { platform: 'X' }),
  facebook: t('blog.share.shareTo', { platform: 'Facebook' }),
  linkedin: t('blog.share.shareTo', { platform: 'LinkedIn' }),
  threads: t('blog.share.shareTo', { platform: 'Threads' }),
  mail: t('blog.share.shareViaEmail'),
};
---

<PageLayout
  title={entry.data.title}
  description={entry.data.description}
  locale={locale}
>
  <ArticleJsonLd
    slot="json-ld"
    title={getFullTitle(entry.data.title)}
    description={entry.data.description}
    pubDate={entry.data.pubDate}
    lastModified={lastModifiedDate.toDate()}
  />
  <CodeGroupEvent client:only="react" />
  <AffixTitle title={entry.data.title} offsetTop={100} client:idle />

  <div class="mb-16" slot="header">
    <Button id="back">←</Button>
  </div>

  <div class="blog-content">
    <div class="mb-16">
      <h1>{entry.data.title}</h1>
      <div class="text-slate10">
        <div class="flex flex-wrap items-center gap-2">
          <span>{formattedPubDate}</span>
          {!!slateConfig.readTime && <span>·</span>}
          {
            slateConfig.readTime && (
              <span>
                {t('blog.readingTime', {
                  minutes: remarkPluginFrontmatter.minutesRead,
                })}
              </span>
            )
          }
        </div>
        <Share
          title={entry.data.title}
          url={Astro.url.href}
          labels={shareLabels}
          showLabel={false}
          className="mt-3 max-w-full"
          client:load
        />
      </div>
      {
        isAuto && (
          <div class="bg-slate3 text-slate10 mt-4 rounded-md px-3 py-2 text-sm">
            {t('blog.aiTranslated')}
          </div>
        )
      }
    </div>
    <Content />
    {
      slateConfig.lastModified && (
        <div class="text-slate8">
          {t('blog.lastModified')} {lastModified}
        </div>
      )
    }
    <Share
      title={entry.data.title}
      url={Astro.url.href}
      labels={shareLabels}
      className="mt-12 pt-6"
      client:load
    />
  </div>
  <!-- E 内容 -->
  {
    (previousPost || nextPost) && (
      <nav
        aria-label={t('blog.navigation.label')}
        class="border-slate4 mb-16 grid grid-cols-1 gap-4 border-t pt-6 sm:grid-cols-2"
      >
        {previousPost && (
          <a
            href={`/${locale}/blog/${previousPost.slug}`}
            rel="prev"
            class="hover:bg-slate3 focus-visible:outline-slate8 min-w-0 rounded-lg p-3 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2"
          >
            <span class="text-slate10 flex items-center gap-2 text-sm">
              <span aria-hidden="true">←</span>
              {t('blog.navigation.previous')}
            </span>
            <span class="text-slate12 mt-2 block text-base leading-relaxed break-words">
              {previousPost.entry.data.title}
            </span>
          </a>
        )}
        {nextPost && (
          <a
            href={`/${locale}/blog/${nextPost.slug}`}
            rel="next"
            class="hover:bg-slate3 focus-visible:outline-slate8 min-w-0 rounded-lg p-3 text-right transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 sm:col-start-2"
          >
            <span class="text-slate10 flex items-center justify-end gap-2 text-sm">
              {t('blog.navigation.next')}
              <span aria-hidden="true">→</span>
            </span>
            <span class="text-slate12 mt-2 block text-base leading-relaxed break-words">
              {nextPost.entry.data.title}
            </span>
          </a>
        )}
      </nav>
    )
  }
  <!-- S 目录 -->
  <Toc
    className="fixed top-0 right-0 bottom-0 hidden w-64 xl:block"
    listClassName="px-5 pt-44 pb-14 "
    dataSource={headings}
    client:visible
  />
  <!-- E 目录 -->
</PageLayout>

<script src="//unpkg.com/heti/umd/heti-addon.min.js" is:inline></script>
<script is:inline define:vars={{ homeHref }}>
  const backBtn = document.getElementById('back');
  backBtn?.addEventListener('click', () => {
    window.location.href = homeHref;
  });

  const heti = new Heti('.blog-content');
  heti.autoSpacing();
</script>
